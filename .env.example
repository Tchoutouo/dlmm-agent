# --- Réseau & données ---
# Unique point d'entrée Meteora (pools + OHLCV) — l'ancien dlmm-api.meteora.ag est hors service.
METEORA_DATA_API_BASE=https://dlmm.datapi.meteora.ag
JUPITER_PRICE_API=https://lite-api.jup.ag/price/v3
SOLANA_RPC_URL=https://api.devnet.solana.com
NETWORK=devnet

# --- Sécurité ---
# DRY_RUN=true : aucune transaction réelle n'est envoyée (défaut).
# Passe à false UNIQUEMENT quand l'agent d'exécution (Phase 2) est prêt et audité.
DRY_RUN=true
# --- Journal ---
JOURNAL_DB_PATH=./data/journal.db

# --- Garde-fous de risque (Agent 2) ---
INITIAL_CASH_USD=1000
MAX_POSITION_USD=100
MIN_POSITION_USD=10
MAX_DRAWDOWN_PCT=15
MAX_PORTFOLIO_EXPOSURE_PCT=80
MAX_POOL_CONCENTRATION_PCT=25
MAX_POOL_LIQUIDITY_SHARE_PCT=1
RISK_BUDGET_PER_TRADE_PCT=2
MAX_VOLATILITY_ANNUAL_PCT=400
MIN_NET_APR_PCT=5
MAX_STRESS_LOSS_PCT=40
QUOTE_DAILY_VOL_PCT=5
# Durée de détention (jours) : clôture à l'échéance ET horizon de l'IL attendu (±1σ√h).
PAPER_HOLDING_DAYS=1
# Frais de priorité des transactions DLMM (micro-lamports / unité de calcul ; 0 = désactivé).
PRIORITY_FEE_MICROLAMPORTS=20000
# Mode supervisé : durée de vie d'une proposition (min) ; revalidée avant ouverture.
APPROVAL_TTL_MIN=120
# Forme des positions PAPER : spot (deux côtés, centré sur le prix) ou sol_bidask
# (un seul côté en SOL/stable, bins sous le prix, plus chargés en profondeur).
# Comparer d'abord avec : npm run backtest:strategy
PAPER_STRATEGY=spot
# Perte journalière max (% de la NAV d'ouverture du jour UTC) → plus d'entrée jusqu'à demain. 0 = désactivé.
MAX_DAILY_LOSS_PCT=5

# --- Sélection des pools (scanner) — 0 = filtre désactivé ---
# Volume 24h / TVL minimal (sous 1, la liquidité tourne trop peu pour générer des fees).
MIN_VOLUME_TVL_RATIO=1
# Market cap minimale du token de base (USD).
MIN_MARKET_CAP_USD=1000000
# Volume 4h extrapolé sur 24h / volume 24h : écarte les pools dont l'activité s'effondre.
MIN_RECENT_VOLUME_RATIO=0.5
# Bonus de score (0..1) pour les pools qui versent leurs fees en SOL/stable (mode OnlyY).
QUOTE_FEES_SCORE_BONUS=0.1
# Couverture minimale (%) du range dicté par la volatilité par la position exécutable
# (69 bins) : en dessous, bin step trop petit → VETO. 0 = désactivé.
MIN_RANGE_COVERAGE_PCT=50
# Modèle de fees calibré on-chain : une position touche les fees de SES bins, pas sa
# part de TVL. Facteur mesuré (liquidité près du prix) plafonné ici. 0 = modèle de base.
MAX_FEE_CONCENTRATION=2
# RPC mainnet de LECTURE (liquidité des bins), distinct du RPC d'exécution.
MAINNET_READ_RPC_URL=https://api.mainnet-beta.solana.com
# Backtest : coût d'un aller-retour (swaps d'entrée/sortie, frais réseau), en % de la taille.
BACKTEST_TRADE_COST_PCT=0.2
# Écarte les copies de tokens (même symbole qu'un token à plus grosse market cap).
EXCLUDE_TOKEN_COPIES=true
# Univers de pools : all (toutes) ou bluechip_sol (blue chip coté en SOL, identifié par mint).
POOL_UNIVERSE=all
# Mints blue chip supplémentaires, séparés par des virgules (en plus de la liste intégrée).
BLUECHIP_EXTRA_MINTS=

# --- Exécution réelle (Agent 3) — NE PAS activer sans validation ---
# Wallet DÉDIÉ uniquement (jamais ton principal), clé secrète base58. NE JAMAIS committer.
# WALLET_SECRET_KEY=
# Garde-fou mainnet : doit valoir true pour autoriser un envoi sur mainnet-beta.
ACKNOWLEDGE_REAL_FUNDS=false
# Demi-largeur du range en bins de part et d'autre du bin actif.
DLMM_RANGE_BINS=10

# --- Couche ML (prédiction de volatilité) — optionnelle ---
# Active l'appel au microservice Python ; sinon repli sur la vol réalisée.
ML_ENABLED=false
ML_SERVICE_URL=http://localhost:8000

# --- Whale-tracking on-chain ---
WHALE_MIN_USD=10000
WHALE_LOOKBACK_TX=50

